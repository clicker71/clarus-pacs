# clinfer.conf.example.en - annotated reference for the BASE layer.
#
# Copy this file to clinfer.conf next to the clinfer binary and edit per
# site. This is the NORMATIVE English version; a Russian translation with
# IDENTICAL YAML lives in clinfer.conf.example.ru.
#
# The file must be UTF-8 WITHOUT a BOM: Notepad's "UTF-8" and
# PowerShell's `Set-Content -Encoding utf8` both write a BOM, and a BOM
# is a load error.
#
# WHAT IS NOT HERE: a model. Each model is one `*.yaml` file in the
# directory `models_dir` names, so adding a model is dropping a file in
# there and removing one is deleting it. See models/clahe.yaml for the
# smallest working model and the other models/*.yaml files for one example
# per shipped demo.
#
#   ./clinfer -t        validate this file AND the models directory
#
# clinfer is a DICOMweb sidecar: it claims UPS workitems, runs a model and
# pushes the results BACK to the PACS as ordinary DICOM objects.

server:
  # The DICOMweb origin of the PACS (UPS/QIDO/WADO/STOW target).
  base_url: "http://127.0.0.1:8024/dicomweb"

  # Actor name stamped via the X-Authenticated-User proxy header (not an
  # AE title - clinfer is pure DICOMweb, no DIMSE). The server logs and
  # audits actions under this name.
  identity_user: "clinfer"

  # This sidecar's operational listener: /health, /metrics, /version and
  # the model declaration at /processors/Questionnaire. Loopback only by
  # default, and a WILDCARD bind is refused at startup. Nothing inbound is
  # required for work to arrive - the sidecar opens the WebSocket
  # Notification Connection itself - so this is purely the observability
  # surface. In production TLS is nginx in front, same as Clarus.
  listen: "127.0.0.1:8124"                # the default

  # Peers allowed to call the operational endpoints above. The origin and
  # a local supervisor are on the loopback address, so it is listed
  # explicitly: an unlisted peer is refused, and an empty list is not
  # "trust everyone".
  trusted_proxies: ["127.0.0.1"]

  # Strict identity mode: a trusted peer WITHOUT the X-Authenticated-User
  # header gets 502. Production choice: true; the shipped default is the
  # soft mode (false + WARN). With true, trusted_proxies must be non-empty.
  require_proxy_identity: false           # the default

  # Station identity: THIS performer's own AE Title and human-readable
  # station name. AIW-I names the station in three places, and all three
  # are this ONE value:
  #   - (0040,0001) Scheduled Station AE Title, sent as a matching key on
  #     every UPS-RS search (AIW-I 4.81.4.1.2.2);
  #   - (0040,4025) Scheduled Station Name Code Sequence Code Value, the
  #     assignment attribute a claim compares against (4.82.4.1.1);
  #   - (0040,4028) Performed Station Name Code Sequence, written on the
  #     update that closes the step (4.84.4.1.2.1).
  #
  # It is NOT an instance identity: every sidecar serving one station
  # carries the same title, because the origin names the station, not the
  # process.
  station_aet: "CLINFER"                  # the default

  # The Code Meaning of (0040,4028) - what an operator reads in the
  # archive next to the result. Defaults to station_aet when absent.
  station_name: "Inference station"

  # How often to SEARCH the worklist while the notification channel is
  # unavailable, in seconds. Default 2; 0 disables it.
  #
  # This knob exists for origins that do NOT service the notification
  # channel (dcm4chee-arc without the UPS-RS push channel behaves this
  # way). An origin that DOES have the channel - Clarus included - pushes
  # Event Reports over it, so this key is irrelevant there.
  poll_interval_secs: 2                   # the default; 0 disables

engine:
  # Where work directories and the result cache live.
  cache_dir: "./cache"

  # HOW MANY MODEL PROCESSES MAY RUN AT THE SAME TIME. Not a thread count:
  # threads are not the scarce resource - the model processes are.
  #
  # Absent (the default) = every ENABLED model may run at once. The value
  # is a CEILING, never a target, and a value above the number of enabled
  # models is capped to it rather than refused (0 is refused: it would mean
  # a sidecar that claims work and never runs it).
  workers: 2                              # default: one per enabled model

# WHERE THE MODELS ARE, relative to THIS FILE. Every `*.yaml` in it is one
# model; a file with `enabled: false` is read and validated as an example
# but is not registered, so a shipped example cannot dispatch anything.
#
# The directory is anchored at the configuration file, not at the process
# working directory, so a deployment is a directory that can be moved whole.
models_dir: ./models

# What to do when NO model matches a workitem:
#   cancel - claim it, then cancel it, so the study is accounted for
#            instead of silent (the shipped default);
#   off    - never claim it, leaving it SCHEDULED for whoever does want it.
default_rule: cancel              # cancel | off (+ counter)

# A MODEL FILE, in the directory above:
#
#   enabled: true
#   title: "CLAHE contrast enhancement"
#   description: "..."
#   provider: { name: clinfer-clahe, vendor: Clarus, version: "1.0" }
#   procedure_code: { value: "363680008", scheme: http://snomed.info/sct,
#                     meaning: "Radiographic imaging procedure" }
#   input_requirements:
#     modalities: [DX, CR]
#     photometric_interpretation: [MONOCHROME2]
#     anatomy:
#       - { system: http://snomed.info/sct, code: "51185008",
#           meaning: "Thoracic structure" }
#   output_capabilities:
#     sop_classes: ["1.2.840.10008.5.1.4.1.1.7"]
#   parameters:
#     - { code: CLIP_LIMIT, type: decimal, text: "Clip limit",
#         default: 2.0, min: 0.1, max: 40.0 }
#   match:
#     modality: [DX]
#     study_description_contains: ["*chest*"]
#   runtime:
#     script: "../abi/DERIVED-clahe.py"
#     interpreter: "python3"
#     timeout_secs: 300
#   outputs:
#     - { kind: derived, series_description: "CLAHE", profile_version: 1 }
#
# `parameters[].type` is the FHIR R4 Questionnaire item type: boolean,
# decimal, integer, date, dateTime, time, string, text, url, choice,
# open-choice, attachment, reference, quantity. `repeats: true` makes the
# item multi-select and allows a LIST default; a list default on
# `repeats` false is refused by `-t`.
#
# OPERATIONS:
# SIGTERM/SIGINT stop gracefully (refuse new pushes, finish the held
# workitem, exit 0); a second signal exits immediately. A PID file
# `<config>.pid` prevents a second clinfer on the same config: a stale
# one is overwritten, only a LIVE foreign pid is fatal. A KILLED process
# (SIGKILL, power loss) can strand a workitem IN PROGRESS - no sidecar
# can release it (no DICOMweb cancel server-side): the restarted clinfer
# logs the conflict WITH THE WORKITEM UID. Operator action: reset that
# workitem's state through the server's admin API.
