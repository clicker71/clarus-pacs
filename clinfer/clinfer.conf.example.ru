# clinfer.conf.example.ru - русская версия эталонного конфига.
# РУССКАЯ КОПИЯ. English original is normative: clinfer.conf.example.en.
#
# Скопируй этот файл в clinfer.conf рядом с бинарником clinfer и правь
# под площадку. Файл обязан быть UTF-8 БЕЗ BOM: «Блокнот» (UTF-8) и
# PowerShell `Set-Content -Encoding utf8` добавляют BOM, а BOM - это
# ошибка загрузки.
#
# clinfer - DICOMweb-сателлит: берёт UPS-воркитемы, гоняет модели и
# возвращает результат в PACS как обычные DICOM-объекты.

server:
  # DICOMweb-origin PACS (цель UPS/QIDO/WADO/STOW).
  base_url: "http://127.0.0.1:8024/dicomweb"

  # Имя актора, штампуемое в заголовке X-Authenticated-User (не AE-title:
  # clinfer - чистый DICOMweb, без DIMSE). Сервер логирует и аудирует
  # действия под этим именем.
  identity_user: "clinfer"

  # Слушатель этого сайдкара для эксплуатации: /health, /metrics,
  # /version и меню /processors. По умолчанию только loopback, а
  # WILDCARD-привязка отклоняется на старте. Для прихода работы входящий
  # порт НЕ нужен: сайдкар сам открывает WebSocket-соединение
  # уведомлений, так что это исключительно поверхность наблюдаемости.
  # В проде TLS - это nginx впереди, как и у Clarus.
  listen: "127.0.0.1:8124"                # значение по умолчанию

  # Кому разрешено обращаться к эксплуатационным эндпоинтам выше.
  # Origin и локальный супервизор сидят на loopback-адресе, поэтому он
  # прописан ЯВНО: обращение от пира вне списка отклоняется, а пустой
  # список - это не «доверяем всем». Воркитемы больше никто не пушит.
  trusted_proxies: ["127.0.0.1"]

  # Строгий режим: доверенный пир БЕЗ заголовка X-Authenticated-User
  # получает 502. Продакшн-выбор: true; поставляемый дефолт - мягкий
  # режим (false + WARN). При true список trusted_proxies обязан быть
  # непустым.
  require_proxy_identity: false           # значение по умолчанию

  # Идентичность станции: собственный AE-title этого исполнителя и
  # человекочитаемое имя станции. AIW-I называет станцию в трёх местах, и
  # все три - это ОДНО значение:
  #   - (0040,0001) Scheduled Station AE Title - ключ сравнения в каждом
  #     поиске UPS-RS, чтобы origin отдавал работу, предложенную этой
  #     станции, а не всю очередь (AIW-I 4.81.4.1.2.2);
  #   - (0040,4025) Scheduled Station Name Code Sequence Code Value -
  #     атрибут назначения, с которым сверяется claim (4.82.4.1.1);
  #   - (0040,4028) Performed Station Name Code Sequence - пишется в
  #     update, закрывающем шаг (4.84.4.1.2.1).
  #
  # Это НЕ идентичность инстанса: все сайдкары одной станции несут один и
  # тот же title, потому что origin называет станцию, а не процесс. Укажите
  # AE-title, под которым Task Manager знает этого исполнителя; без ключа
  # значение - CLINFER.
  station_aet: "CLINFER"                  # значение по умолчанию

  # Code Meaning для (0040,4028) - то, что оператор читает в архиве рядом
  # с результатом. Без ключа берётся station_aet.
  station_name: "Станция инференса"

  # Как часто ОПРАШИВАТЬ worklist, пока канал нотификаций недоступен,
  # в секундах. По умолчанию 2; 0 отключает опрос.
  #
  # Ключ нужен для origin'ов, которые НЕ обслуживают канал нотификаций -
  # origin отклоняет Subscribe и отвечает 404 на WebSocket-хендшейк (так
  # ведёт себя dcm4chee-arc, если push-канал UPS-RS не включён). Канала
  # нет - значит нет и push: без этого ключа workitem, созданный ПОСЛЕ
  # запуска сайдкара, останется невидимым до перезапуска.
  #
  # Origin, у которого канал ЕСТЬ - включая Clarus - присылает Event
  # Reports по нему, поэтому доставка идёт каналом, а ключ там ни на что
  # не влияет: оставьте значение по умолчанию (или поставьте 0), и
  # изменится только то, что лишних поисков при живом канале не будет.
  # Поиск выполняется ТОЛЬКО пока канал лежит; работающему каналу эта
  # настройка ничего не замедляет.
  #
  # Это интервал фолбэка, а не цикл опроса для здорового деплоя: каждый
  # поиск - это запрос к worklist, а найденную работу забирает всё тот же
  # единственный воркер. Опрос не конкурирует за claim, он лишь делает
  # работу видимой раньше.
  poll_interval_secs: 2                   # значение по умолчанию; 0 отключает

engine:
  # Где живут рабочие каталоги прогонов и кеш результатов.
  cache_dir: "./cache"

  # СКОЛЬКО ПРОЦЕССОВ МОДЕЛЕЙ МОГУТ ИДТИ ОДНОВРЕМЕННО. Это не число потоков:
  # поток на каждую модель уже есть, и потоки здесь не дефицитный ресурс -
  # дефицитны именно процессы моделей. Две модели сразу стоят RAM двух моделей
  # (сотни МБ каждая на настоящей) и дают два параллельных запроса к origin,
  # что и ограничивает этот ключ.
  #
  # Отсутствует (значение по умолчанию) = каждая модель, у которой объявлен
  # `script`, может идти сразу. Это естественное чтение конфигурации, где их
  # объявили несколько, а с ОДНОЙ моделью поведение ровно такое же
  # последовательное, какое было всегда - тогда ключ ничего не делает, и это
  # нормально.
  #
  # КОГДА УМЕНЬШАТЬ:
  #   - 3+ модели на хосте, где RAM теснее, чем хотят модели;
  #   - origin начинает отвечать 503, пока занято несколько моделей (каждая
  #     идущая модель - это один вызывающий, и очередь транскодирования на
  #     стороне origin - то, за что они конкурируют);
  #   - первый деплой новой модели, где один прогон за раз - осторожная
  #     пилотная настройка.
  # КОГДА НЕ ТРОГАТЬ: одна-две модели на машине, где им хватает места.
  #
  # Значение - это ПОТОЛОК, никогда не цель: модель с пустой очередью ничего
  # не занимает, и ключ сам никогда не запускает работу. Значение ВЫШЕ числа
  # моделей с `script` обрезается до него, а не отвергается (0 отвергается: это
  # был бы sidecar, который забирает работу и никогда её не делает).
  workers: 2                              # по умолчанию: одна на модель со script

# --------------------------------------------------------------------
# МОДЕЛИ: каждая модель - ВНЕШНИЙ ПРОЦЕССОР (путь ABI).
#
# Своего движка инференса у clinfer НЕТ. Модель объявляется одним
# ключом `script` - значения `kind` не существует, потому что нечего
# им описывать. clinfer складывает кадры исследования в рабочий
# каталог, запускает программу над ним, читает один строго-схемный
# result.json и САМ кодирует производные DICOM-объекты. Процессор не
# видит ни одного DICOM-объекта и не нуждается в DICOM-библиотеке.
#
#   <интерпретатор> <скрипт> <workdir>
#
# Полный контракт - clinfer/abi/README.md; DERIVED-clahe.py,
# PR-openvino-detect.py, SR-llm.py, SEG-threshold.py, RTSTRUCT-contours.py,
# SR-DX-torchxrayvision-regions.py и STL-mesh.py рядом с ним суть запускаемые примеры.
# Площадка копирует один из них и правит константы модели (пути,
# размеры, URL эндпоинта) в своей копии.
#
# Процессор - ОБЫЧНАЯ ПРОГРАММА: его можно запустить и отладить
# руками, без clinfer, из рабочего каталога, который называет
# audit-строка. Скрипты - доверенная конфигурация оператора; clinfer
# их не изолирует.
#
# Окружение дочернего процесса ЧИСТИТСЯ (остаются только PATH и
# PYTHONUNBUFFERED), поэтому конфигурация площадки для скрипта - пути
# моделей, URL эндпоинта, ключ - кладётся либо в собственную копию
# скрипта, либо в wrapper-скрипт площадки, указанный как interpreter:
#
#     #!/bin/bash
#     export SR_LLM_MODEL="smolvlm"
#     exec /opt/clinfer/venv/bin/python "$@"
#
# timeout_secs - бюджет одного прогона; по его истечении убивается ВСЁ
# дерево процессов (скрипт с multiprocessing не должен осиротить своих
# воркеров). Повторов нет.
# На Linux всё дерево убивается как ОДНА группа процессов, поэтому
# worker-пул умирает вместе со скриптом. На Windows tree-kill обходит
# зарегистрированных детей родителя, и помощник, отцепившийся сам,
# может пережить таймаут. Для скрипта модели, который заводит
# вспомогательные процессы, требующие надзора (multiprocessing,
# загрузчики данных), НАСТОЯТЕЛЬНО рекомендуется Linux-развёртывание.
#
# max_result_bytes - потолок размера result.json этого модуля, в
# байтах; суффиксы `k` и `m` принимаются (64m, 512m). Ключ НА МОДУЛЬ,
# потому что размер - свойство того, что модуль производит: детектор
# пишет килобайты, а оконтуриватель - мегабайты, и одно число на оба
# оказывается неверным для одного из них. По умолчанию 64m - к этому
# ни список боксов, ни отчёт не приближаются.
#
# STRUCTURE SET растёт вместе с числом обведённых точек (три
# координаты на точку), поэтому МНОГОКАДРОВОМУ объёмному
# исследованию нужно больше: живой замер на КТ - около 0,5 МиБ на
# кадр, а исследование из 53 кадров дало 26,8 МиБ. Для исследования
# в несколько сотен кадров поставьте бюджет больше, напр. 512m на
# том модуле, который его оконтуривает. Документ - это вывод самого
# модуля на этой машине, поэтому предел ограничивает зацикленный
# скрипт, а не недоверенный вход; у закодированного объекта есть
# собственный потолок на контур, который никакое значение здесь не
# поднимет.
#
# Результат сверх бюджета отвергается как «produced no result» в
# воркитеме; в лог при этом попадает причина целиком, с именем ключа:
#
#   result.json is N bytes, over the model's max_result_bytes limit of M
#
# то есть по самой строке видно, какому модулю поднять бюджет.
# Допустимый диапазон: 1 байт .. 1 ГиБ. 0 отвергается: удалите модуль
# вместо этого.

models:
  # Детектор: boxes -> result.kind pr (оверлей GSPS, его рендерит
  # Weasis). Пример - PR-openvino-detect.py; площадка направляет свою
  # копию на свой экспортированный IR-файл и свои labels. Пути
  # ОТНОСИТЕЛЬНЫ этого файла: собранный пак работает из любого
  # каталога, на любой ОС.
  detect-pr:
    script: "scripts/PR-openvino-detect.py"
    interpreter: "venv/bin/python"   # по умолчанию python3
    timeout_secs: 300           # 5..1800, по умолчанию 300
    # max_result_bytes: 64m     # на модуль, 1..1g, по умолчанию 64m

  # Отчёт: свободный текст -> result.kind sr (Basic Text SR). Пример
  # SR-llm.py САМ ходит на OpenAI-совместимый эндпоинт (свой URL, ключ
  # и промпт - сетевая политика живёт там, где живёт скрипт). Эндпоинт
  # может быть локальным сервером модели (llama-server, LocalAI,
  # ollama) или облачным через ЛОКАЛЬНЫЙ nginx-хоп площадки; сверься с
  # политикой данных площадки до включения всего, что покидает машину.
  #
  # report-llm:
  #   script: "/opt/clinfer/scripts/SR-llm.py"
  #   interpreter: "/opt/clinfer/scripts/sr_llm_wrapper.sh"  # см. выше
  #   timeout_secs: 300           # 5..1800

  # Измерения: числа + контурные регионы SCOORD -> result.kind
  # measurements (Enhanced SR, TID 1500). Weasis показывает значения
  # NUM в отчёте и рисует каждый регион SCOORD на изображении.
  # SR-DX-torchxrayvision-regions.py - пример ТОЛЬКО ДЕМО: гоняет PSPNet из
  # torchxrayvision по рентгенограмме грудной клетки и пишет долю
  # покрытия каждой структуры как NUM, а обведённый контур маски
  # самой модели - как регион. Дисклеймер карточки - в шапке скрипта;
  # веса НЕ ШИППУЮТСЯ - площадка качает их в свой venv (torch +
  # torchxrayvision).
  #
  # measure-xrv:
  #   script: "/opt/clinfer/scripts/SR-DX-torchxrayvision-regions.py"
  #   interpreter: "/opt/site/venv/bin/python"
  #   timeout_secs: 600

  # Маска: пиксельные маски -> result.kind seg (DICOM SEG).
  # SEG-threshold.py - лицензионно чистый эталонный пример.
  # SEG-DX-chest.py - ТОЛЬКО ДЕМО (клиническая модель
  # ianpan/chest-x-ray-basic): дисклеймер карточки - в шапке скрипта,
  # веса НЕ ШИППУЮТСЯ - площадка качает модель сама, в свой venv.
  #
  # seg-demo:
  #   script: "/opt/clinfer/scripts/SEG-threshold.py"
  #   interpreter: "/opt/clinfer/venv/bin/python"
  #   timeout_secs: 1800

  # КТ челюсти: настоящая КТ-модель, отдающая ОБА объекта - seg и
  # rtstruct - за ОДИН прогон (RTSTRUCT-CT-totalseg.py -> TotalSegmentator,
  # задача craniofacial_structures).
  #
  # Две вещи сделать ДО включения правила:
  #
  #   1. Свой отдельный venv для TotalSegmentator: он тянет torch, а
  #      venv из abi/requirements.txt - для мелких примеров.
  #   2. ЗАРАНЕЕ СКАЧАТЬ ВЕСА. Первый прогон качает ~2 ГБ в
  #      ~/.totalsegmentator, и это само по себе может съесть
  #      timeout_secs и отменить воркитем по причине, не связанной с
  #      исследованием:
  #          /opt/site/venv/bin/python -m \
  #              totalsegmentator.bin.totalseg_download_weights
  #      Офлайн-машины копируют этот каталог (README тула).
  #
  # timeout_secs = 1800: задача считает на 0.5 мм и ОТКАЗЫВАЕТСЯ от
  # --fast, то есть более быстрого режима просто нет. max_result_bytes
  # оставлен дефолтным (64 МиБ) намеренно: маски seg лежат отдельными
  # ФАЙЛАМИ в workdir, поэтому этот бюджет тратится только на контуры
  # RS, а три органа по <=2000 точек - на порядок меньше.
  #
  # totalseg:
  #   script: "/opt/clinfer/scripts/RTSTRUCT-CT-totalseg.py"
  #   interpreter: "/opt/site/venv/bin/python"
  #   timeout_secs: 1800
  #   # max_result_bytes: 64m     # дефолт; маски в него не входят

  # Контуры: полигоны ROI -> result.kind rtstruct (RT Structure Set),
  # рисуются на кадрах исследования. RTSTRUCT-contours.py -
  # лицензионно чистый эталонный пример: без модели и без весов -
  # порогует СЫРЫЕ пиксели аксиального КТ (окна кости и зубов),
  # обводит внешние контуры и отдаёт один блок rtstruct. Окна HU
  # правь в СВОЕЙ копии под свои данные.
  #
  # rtstruct-demo:
  #   script: "/opt/clinfer/scripts/RTSTRUCT-contours.py"
  #   interpreter: "/opt/clinfer/venv/bin/python"
  #   timeout_secs: 1800

  # Новое изображение (denoise/сверхразрешение) -> result.kind derived;
  # модальность источника сохраняется. Пример: DERIVED-clahe.py.
  #
  # clahe-demo:
  #   script: "/opt/clinfer/scripts/DERIVED-clahe.py"
  #   interpreter: "/opt/clinfer/venv/bin/python"

  # 3D-поверхность из ОБЪЁМНОГО исследования (CT/MR: из плоского
  # снимка поверхность не построить) -> result.kind stl. Пример:
  # STL-mesh.py.
  #
  # mesh-demo:
  #   script: "/opt/clinfer/scripts/STL-mesh.py"
  #   interpreter: "/opt/clinfer/venv/bin/python"
  #   timeout_secs: 1800

rules:                            # тип исследования -> модель; работают ВСЕ совпавшие
  # S1: одно правило -> одна модель. ПЕРВЫЙ ключ - код воркитема:
  #   code - (0040,4018) Scheduled Workitem Code Sequence, значение,
  #     в верхнем регистре. Задача сама несёт своё намерение, поэтому
  #     правилу, ограниченному кодом, выборка исследования НЕ нужна.
  #     Отсутствие ключа code ничего не ограничивает - именно это
  #     означали все правила до появления ключа, так что существующие
  #     правила продолжают работать без миграции.
  #
  #     Код на STOW пишет серверный триггер по модальности исследования
  #     через свою таблицу [ups.workitem_code] (исследование DX получает
  #     CXR-AI, CT - CT-ORGAN-SEG, всё прочее - настроенный
  #     фолбэк). Воркитем, созданный вручную, несёт тот код, который
  #     прислал его отправитель.
  #
  # Второй ключ - modality, остальные ключи опциональны; достаточно
  # ЛЮБОГО одного:
  #   study_description_contains (0008,1030); code_meaning_contains
  #   (0008,0104 внутри последовательностей); body_part_contains
  #   (0018,0015); tag - привязка ЛЮБОГО (group,element) к паттернам,
  #   ключи БЕЗ кавычек:
  #       tag: { 00181030: ["*chest*"] }

  # Какой объект записать, решает САМ СКРИПТ своим result.json (в нём
  # может быть любая комбинация блоков
  # pr/sr/measurements/seg/rtstruct/derived/stl). Блок `result` правила
  # несёт МЕТАДАННЫЕ того, что кодирует clinfer: kind
  # (для энкодера и меню), описание серии и версию профиля.
  - match:
      modality: [DX, CR]
      study_description_contains: ["*chest*", "*thorax*"]
      code_meaning_contains: ["*thorax*", "*chest*"]
    model: "detect-pr"
    result:
      kind: pr                    # оверлей GSPS (его рендерит Weasis)
      color: "#FF3B30"            # цвет по умолчанию для ВСЕХ коробок
      # Цвета по классам (только pr, опционально): по слою GSPS на
      # класс; `color:` обязателен вместе с `colors:`; класс вне карты
      # получает `color`.
      # colors: { Nodule: "#FF3B30", Mass: "#007AFF" }
      profile_version: 1          # ключ кеша/инвалидации
      # Поднимай при смене весов модели или параметров энкодера;
      # инвалидируется только кеш сайдкара - сохранённые PR здесь не
      # удаляются (админ-API). Геометрия подписи (только pr; left < right):
      # label:
      #   anchor: tl               # tl = левый верх коробки, center = центр
      #   offset_y_px: -110        # отрицательное = над коробкой
      #   offset_x_left_px: -200   # сдвиг левого края бокса подписи
      #   offset_x_right_px: 80    # сдвиг правого края бокса подписи
      # series_description: "..."  # опционально (0008,103E)

  # ------------------------------------------------------------------
  # ПРИМЕРЫ (все закомментированы). Правила читаются СВЕРХУ ВНИЗ:
  # срабатывает КАЖДОЕ совпавшее, в порядке строк файла - для любой
  # области (мозг, колени, лёгкие) и в любой комбинации блоков
  # (маска/прямоугольники/отчёт - любого может не быть). Если ни одно
  # не совпало, внизу default_rule: cancel. Порядок правил = порядок
  # в файле.
  #
  # Структура правила:
  # match:
  #   modality: [DX, CR]           # обязателен: список модальностей
  #   study_description_contains: ["*chest*", "*thorax*"]   # опц.
  #   code_meaning_contains: ["*thorax*", "*chest*"]        # опц.
  #   body_part_contains: ["*chest*"]                       # опц.
  #   tag: { 00181030: ["*chest*"] }                        # опц.
  # model: "detect-pr"             # обязателен
  # result:
  #   kind: pr            # pr | sr | measurements | seg | rtstruct | derived | stl
  #
  # 1. ОТЧЁТ (SR, Basic Text) - скрипт сам ходит на свой эндпоинт:
  # - match:
  #     modality: [DX, CR]
  #     study_description_contains: ["*chest*", "*thorax*"]
  #   model: "report-llm"
  #   result:
  #     kind: sr
  #     series_description: "LLM Findings"
  #     profile_version: 1
  #     sr:
  #       title: "LLM Findings"
  #       template_id: TID2000
  #
  # 2. МАСКА (SEG):
  # - match:
  #     modality: [DX, CR]
  #     study_description_contains: ["*chest*", "*thorax*"]
  #   model: "seg-demo"
  #   result:
  #     kind: seg
  #     series_description: "AI Segmentation"
  #     profile_version: 1
  #
  # 2b. КТ ЧЕЛЮСТИ (RTSTRUCT). Ключ `code` -
  # именно то, что заставляет правило срабатывать ТОЛЬКО на нужных
  # воркитемах: серверная таблица [ups.workitem_code] выдаёт КТ-
  # исследованию код ниже, поэтому правило совпадает по нему, НЕ
  # вытаскивая исследование ради описания. Правило по одной
  # модальности гоняло бы модель челюсти на каждой КТ в отделении.
  #
  # Один прогон пишет ОДИН объект: result.json скрипта RTSTRUCT-CT-totalseg.py
  # несёт блок rtstruct с обведёнными контурами, и ключ `kind` называет
  # энкодер для него, поэтому здесь `rtstruct`. Половина seg из этого
  # скрипта удалена, и правило с `kind: seg` не получило бы ничего.
  #
  # - match:
  #     code: [CT-ORGAN-SEG]
  #     modality: [CT]
  #   model: "totalseg"
  #   result:
  #     kind: rtstruct
  #     series_description: "Jaw CT Segmentation"
  #     profile_version: 1
  #
  #
  # 3. DERIVED (новое DICOM-изображение) - denoise/сверхразрешение:
  # - match:
  #     modality: [DX, CR]
  #     study_description_contains: ["*chest*"]
  #   model: "clahe-demo"
  #   result:
  #     kind: derived
  #     series_description: "AI Denoised"
  #     profile_version: 1
  #
  # 4. STL (Encapsulated STL) - 3D-поверхность из ОБЪЁМНОГО
  #    исследования (CT/MR):
  # - match:
  #     modality: [CT, MR]
  #     study_description_contains: ["*liver*"]
  #   model: "mesh-demo"
  #   result:
  #     kind: stl
  #     series_description: "AI Surface"
  #     profile_version: 1
  #
  # 3b. КОНТУРЫ (GSPS из трассированных очертаний, без боксов). Блок
  #     `pr` в result.json скрипта несёт список `contours` - по одной
  #     записи на структуру: метка, кольцо в ПИКСЕЛЯХ кадра `[column,
  #     row]` с повторённой последней точкой и необязательный `frame`
  #     (нумерация с 1). Уверенности нет: у границы маски нет оценки.
  #     Контур пишется закрытой POLYLINE - единственной формой
  #     очертания в DICOM (PS3.3 C.18.6.1.2 не перечисляет POLYGON).
  #     Один скрипт может нести ОБА блока - `measurements` для чисел и
  #     `pr` для очертаний - если написать два правила на одной модели,
  #     по одному `kind` на правило. Правило складывает ВСЕ блоки, которые
  #     выдал его скрипт, поэтому скрипт под двумя правилами должен читать
  #     `profile_version` из манифеста workdir'а и выдавать только блок,
  #     который потребляет вызвавшее его правило - см. SR-DX-torchxrayvision-regions.py.
  # - match:
  #     code: [CXR-AI]
  #     modality: [DX, CR]
  #   model: "measure-xrv"
  #   result:
  #     kind: pr
  #     series_description: "xrv anatomy outlines"
  #     profile_version: 3
  #
  # 5. ИЗМЕРЕНИЯ (Enhanced SR, TID 1500): значения NUM. Ключ
  #    `measurements:` называет заголовок серии и шаблон; блок
  #    `measurements` со значениями несёт result.json скрипта.
  #    Геометрия сюда НЕ входит: очертание - это объект, который
  #    рисуется поверх снимка, а не число, и его место в GSPS (см. блок 3,
  #    `kind: pr` с ключом `contours` в блоке `pr`).
  # - match:
  #     code: [CXR-AI]
  #     modality: [DX, CR]
  #   model: "measure-xrv"
  #   result:
  #     kind: measurements
  #     series_description: "xrv measurements"
  #     profile_version: 1
  #     measurements:
  #       title: "xrv measurements"
  #       template_id: TID1500
  #
  # 6. RTSTRUCT (RT Structure Set): контуры ROI как полигоны в
  #    координатах пациента, рисуются на кадрах исследования. Блок
  #    `rtstruct` несёт result.json скрипта.
  # - match:
  #     modality: [CT]
  #   model: "rtstruct-demo"
  #   result:
  #     kind: rtstruct
  #     series_description: "AI Structures"
  #     profile_version: 1
  #
  # Цепочка универсальна для ЛЮБОЙ области (мозг, колени, лёгкие):
  # совпавшие правила срабатывают ВСЕ, в том порядке, в котором они
  # написаны в файле. Любой блок может отсутствовать.

  # Что делать, когда НИ ОДНО правило не совпало:

default_rule: cancel              # cancel | off (+ счётчик)

# ЭКСПЛУАТАЦИЯ:
# SIGTERM/SIGINT останавливают плавно (отказ в новых push, доведение
# текущего воркитема, выход 0); второй сигнал выходит немедленно.
# PID-файл `<конфиг>.pid` не пускает второго clinfer на тот же конфиг:
# устаревший перезаписывается сам, фатален только ЖИВОЙ чужой pid.
# УБИТЫЙ процесс (SIGKILL, пропало питание) может оставить воркитем
# IN PROGRESS - сайдкар его не освободит (отмены через DICOMweb на
# сервере нет): перезапущенный clinfer пишет конфликт ВМЕСТЕ С UID
# ВОРКИТЕМА. Действия оператора: сбросить состояние воркитема через
# админ-API сервера. Предпочитай SIGTERM жёсткому kill; перезапуски
# назначай вне рабочих часов.
