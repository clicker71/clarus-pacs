# clinfer.conf.example.ru - аннотированный справочник БАЗОВОГО слоя.
#
# Скопируйте этот файл в clinfer.conf рядом с бинарником clinfer и отредактируйте
# под площадку. Русский перевод нормативной английской версии
# (clinfer.conf.example.en); YAML в обоих файлах ИДЕНТИЧЕН, различаются только
# комментарии.
#
# Файл должен быть в UTF-8 БЕЗ BOM: "UTF-8" Блокнота и
# `Set-Content -Encoding utf8` в PowerShell оба пишут BOM, а BOM - ошибка
# загрузки.
#
# ЧЕГО ЗДЕСЬ НЕТ: модели. Каждая модель - это свой файл `*.yaml` в каталоге,
# который называет models_dir: добавить модель - положить файл, убрать -
# удалить файл. См. models/clahe.yaml (минимальная рабочая модель) и остальные
# models/*.yaml (по одному примеру на каждую демо-программу).
#
#   ./clinfer -t        проверить этот файл И каталог моделей
#
# clinfer - сайдкар DICOMweb: он забирает UPS-задачи, запускает модель и
# возвращает результат в PACS обычными DICOM-объектами.

server:
  # DICOMweb-origin PACS (цель UPS/QIDO/WADO/STOW).
  base_url: "http://127.0.0.1:8024/dicomweb"

  # Имя актора в заголовке X-Authenticated-User (это НЕ AE Title - clinfer
  # работает только по DICOMweb, без DIMSE). Сервер пишет это имя в журнал и
  # аудит.
  identity_user: "clinfer"

  # Операционный слушатель самого сайдкара: /health, /metrics, /version и
  # объявление моделей на /processors/Questionnaire. По умолчанию только
  # loopback; wildcard-bind отвергается при старте. Входящий трафик для
  # получения работы не нужен - сайдкар сам открывает WebSocket-канал
  # уведомлений, - так что это только поверхность наблюдаемости. В продакшене
  # TLS ставится nginx-ом, как и у Clarus.
  listen: "127.0.0.1:8124"                # значение по умолчанию

  # Пиры, которым разрешены операционные эндпоинты выше. Origin и локальный
  # супервизор находятся на loopback, поэтому адрес указан явно: пир вне списка
  # отвергается, а пустой список не означает "доверять всем".
  trusted_proxies: ["127.0.0.1"]

  # Строгий режим идентичности: доверенный пир БЕЗ заголовка
  # X-Authenticated-User получает 502. Для продакшена: true; в поставке -
  # мягкий режим (false + WARN). При true список trusted_proxies не может быть
  # пустым.
  require_proxy_identity: false           # значение по умолчанию

  # Идентичность станции: собственный AE Title этого исполнителя и
  # человекочитаемое имя станции. AIW-I называет станцию в трёх местах, и все
  # три - это ОДНО значение:
  #   - (0040,0001) Scheduled Station AE Title, ключ поиска в каждом UPS-RS
  #     запросе (AIW-I 4.81.4.1.2.2);
  #   - (0040,4025) Scheduled Station Name Code Sequence, значение кода, с
  #     которым сверяется claim (4.82.4.1.1);
  #   - (0040,4028) Performed Station Name Code Sequence, записывается при
  #     закрытии шага (4.84.4.1.2.1).
  #
  # Это НЕ идентичность экземпляра: все сайдкары одной станции несут один и тот
  # же title, потому что origin называет станцию, а не процесс.
  station_aet: "CLINFER"                  # значение по умолчанию

  # Code Meaning для (0040,4028) - то, что оператор видит в архиве рядом с
  # результатом. Если ключ отсутствует, берётся station_aet.
  station_name: "Inference station"

  # Как часто ИСКАТЬ worklist, пока канал уведомлений недоступен, в секундах.
  # По умолчанию 2; 0 отключает поиск.
  #
  # Ключ нужен для origin, который НЕ обслуживает канал уведомлений (так ведёт
  # себя dcm4chee-arc без UPS-RS push-канала). Origin, у которого канал есть -
  # включая Clarus, - шлёт Event Report по нему, и там ключ не нужен.
  poll_interval_secs: 2                   # значение по умолчанию; 0 отключает

engine:
  # Где живут рабочие каталоги и кэш результатов.
  cache_dir: "./cache"

  # СКОЛЬКО ПРОЦЕССОВ МОДЕЛЕЙ МОЖЕТ РАБОТАТЬ ОДНОВРЕМЕННО. Это не число
  # потоков: потоки не являются дефицитным ресурсом - им являются процессы
  # моделей.
  #
  # Отсутствует (по умолчанию) = каждая ВКЛЮЧЁННАЯ модель может работать
  # одновременно. Значение - это ПОТОЛОК, а не цель; значение выше числа
  # включённых моделей обрезается до него, а не отвергается (0 отвергается: это
  # был бы сайдкар, который забирает работу и никогда её не выполняет).
  workers: 2                              # по умолчанию: одна на включённую модель

# ГДЕ ЛЕЖАТ МОДЕЛИ, относительно ЭТОГО ФАЙЛА. Каждый `*.yaml` в каталоге -
# одна модель; файл с `enabled: false` читается и проверяется как пример, но не
# регистрируется, поэтому поставляемый пример ничего не запустит.
#
# Каталог привязывается к файлу конфигурации, а не к рабочему каталогу
# процесса, поэтому развёртывание - это каталог, который можно перенести целиком.
models_dir: ./models

# Что делать, если НИ ОДНА модель не подошла к задаче:
#   cancel - забрать задачу и отменить её, чтобы исследование было учтено, а
#            не потерялось молча (значение по умолчанию);
#   off    - не забирать задачу, оставить её SCHEDULED тому, кому она нужна.
default_rule: cancel              # cancel | off (+ счётчик)

# МОДЕЛЬ, в каталоге выше:
#
#   enabled: true
#   title: "CLAHE contrast enhancement"
#   description: "..."
#   provider: { name: clinfer-clahe, vendor: Clarus, version: "1.0" }
#   procedure_code: { value: "363680008", scheme: http://snomed.info/sct,
#                     meaning: "Radiographic imaging procedure" }
#   input_requirements:
#     modalities: [DX, CR]
#     photometric_interpretation: [MONOCHROME2]
#     anatomy:
#       - { system: http://snomed.info/sct, code: "51185008",
#           meaning: "Thoracic structure" }
#   output_capabilities:
#     sop_classes: ["1.2.840.10008.5.1.4.1.1.7"]
#   parameters:
#     - { code: CLIP_LIMIT, type: decimal, text: "Clip limit",
#         default: 2.0, min: 0.1, max: 40.0 }
#   match:
#     modality: [DX]
#     study_description_contains: ["*chest*"]
#   runtime:
#     script: "../abi/DERIVED-clahe.py"
#     interpreter: "python3"
#     timeout_secs: 300
#   outputs:
#     - { kind: derived, series_description: "CLAHE", profile_version: 1 }
#
# `parameters[].type` - тип элемента FHIR R4 Questionnaire: boolean, decimal,
# integer, date, dateTime, time, string, text, url, choice, open-choice,
# attachment, reference, quantity. `repeats: true` делает элемент
# мультивыбором и разрешает СПИСОЧНОЕ значение по умолчанию; список при
# `repeats` false отвергается проверкой `-t`.
#
# ЭКСПЛУАТАЦИЯ:
# SIGTERM/SIGINT останавливают корректно (новые задачи не принимаются,
# текущая доводится, выход 0); второй сигнал завершает немедленно. PID-файл
# `<config>.pid` не даёт запустить второй clinfer на том же конфиге: устаревший
# перезаписывается, фатален только ЖИВОЙ чужой pid. УБИТЫЙ процесс (SIGKILL,
# потеря питания) может оставить задачу в IN PROGRESS - ни один сайдкар не
# может её освободить (отмены на стороне сервера в DICOMweb нет): перезапущенный
# клинфер пишет конфликт С UID ЗАДАЧИ. Действие оператора: сбросить состояние
# этой задачи через admin API сервера.
